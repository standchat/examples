{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": ".",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)\\.usdz",
      "headers": [{ "key": "Content-Type", "value": "model/vnd.usdz+zip" }]
    }
  ]
}
